# ============================================================
# PathPoint Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to source control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB ──────────────────────────────────────────────────
# Required: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# Set to true ONLY in local development to fall back to an in-memory MongoDB
# when the Atlas connection fails. MUST be false in production.
MONGODB_ALLOW_MEMORY_FALLBACK=false

# ── JWT ──────────────────────────────────────────────────────
# Required: Random secret, at least 32 characters long.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Token lifetime (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ── Bootstrap Admin ──────────────────────────────────────────
# On first startup the server creates this admin account automatically.
# Change BOOTSTRAP_ADMIN_PASSWORD before deploying to production.
BOOTSTRAP_ADMIN_NAME=PathPoint Administrator
BOOTSTRAP_ADMIN_USERNAME=pathpoint_admin
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@12345

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://pathpoint.vercel.app,https://www.pathpoint.com
CLIENT_URL=https://your-frontend.vercel.app

# ── Email / SMTP ─────────────────────────────────────────────
# Required for login-code MFA and password reset emails.
# Set EMAIL_DELIVERY_MODE=console to log codes to stdout instead of sending.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail: use an App Password (not your login password)
# https://support.google.com/accounts/answer/185833
SMTP_PASS=your_app_password_here
SMTP_FROM=PathPoint <your-email@gmail.com>
# Set the same random secret in Vercel project environment variables to authorize scheduled reminder dispatch.
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
