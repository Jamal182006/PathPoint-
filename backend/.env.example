# PathPoint Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Create a database user and allow your backend server IP in Atlas first.
# URL-encode special characters in the username or password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pathpoint?retryWrites=true&w=majority
# Keep false so the app never silently uses a non-persistent database.
MONGODB_ALLOW_MEMORY_FALLBACK=false

# JWT Authentication Secret & Expiration
JWT_SECRET=pathpoint_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
