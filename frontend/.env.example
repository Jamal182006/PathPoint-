# ============================================================
# PathPoint Frontend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to source control.
# ============================================================

# ── Backend API ──────────────────────────────────────────────
# Required: Full URL to the PathPoint Express API.
# For local development this is usually http://localhost:5000/api
# For production on Vercel: https://your-backend.railway.app/api  (or similar)
#
# IMPORTANT: All Vite env vars exposed to the browser MUST be prefixed VITE_
VITE_API_URL=https://your-backend-api.railway.app/api
